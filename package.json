{
  "name": "pi-websocket",
  "version": "1.0.0",
  "description": "A browser client for Pi: real-time WebSocket chat, history replay, file transfer, email OTP login, and session controls.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "websocket",
    "realtime",
    "session-streaming"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/index.ts",
    "extensions/auth.ts",
    "extensions/config.ts",
    "extensions/files.ts",
    "extensions/protocol.ts",
    "extensions/serialize.ts",
    "extensions/server.ts",
    "extensions/smtp.ts",
    "client/index.html",
    "client/login.html",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "pi-websocket.config.example.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node test/harness-auth.mjs && node test/harness-history.mjs",
    "test:auth": "node test/harness-auth.mjs",
    "test:history": "node test/harness-history.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "typebox": "^1.3.27"
  }
}
